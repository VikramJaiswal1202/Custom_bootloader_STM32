MEMORY
{
    /*
     * Sector 0 = 16 KB
     * Sector 1 = 16 KB
     * Total bootloader space = 32 KB
     */

    /* Bootloader starts at beginning of Flash and occupies 2 sectors */
    /* Flash mode -> read and execute */
    FLASH (rx) : ORIGIN = 0x08000000, LENGTH = 32K

    /*
     * SRAM1 = 112 KB
     * SRAM2 = 16 KB
     * Total = 128 KB
     */

    /* RAM used for runtime data such as .data and .bss */
    /* Bootloader and application do not run simultaneously */
    /* RAM mode -> read, write and execute */
    RAM (xrw) : ORIGIN = 0x20000000, LENGTH = 128K
}

_estack = ORIGIN(RAM) + LENGTH(RAM);

SECTIONS
{

    /* The vector table is placed at the beginning of the flash memory */

    .isr_vector :
    {
        KEEP(*(.isr_vector))
    } > FLASH

    /* The .text section contains the code and read-only data */
    /* The .text.* are the subsections of the .text section, which are generated by the compiler */
    .text :
    {
        *(.text)
        *(.text.*)
    } > FLASH



    .rodata :
    {
        *(.rodata)
        *(.rodata.*)
    } > FLASH





    _sidata = LOADADDR(.data);

    .data :
    {
        _sdata = .;

        *(.data)
        *(.data.*)

        _edata = .;
    } > RAM AT > FLASH





    .bss :
    {
        _sbss = .;

        *(.bss)
        *(.bss.*)
        *(COMMON)

        _ebss = .;
    } > RAM

    . = ALIGN(8);

    _end = .;
}